{
  "name": "swarm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SWARM — base building survival against the hive",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild src/dev/smoke.ts --bundle --platform=node --format=esm --outfile=.smoke/smoke.mjs --log-level=warning && node .smoke/smoke.mjs",
    "test": "npm run typecheck && npm run smoke",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "icons:desktop": "node scripts/gen-desktop-icons.mjs",
    "electron:dev": "concurrently -k -n VITE,ELECTRON \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "icon-gen": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/screen-orientation": "8.0.1",
    "@capacitor/status-bar": "8.0.3"
  },
  "build": {
    "appId": "com.onyxsystems.swarm",
    "productName": "SWARM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "build/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icons/icon-512.png"
    }
  }
}
